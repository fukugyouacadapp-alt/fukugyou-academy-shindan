# このファイルをコピーして .env.local という名前にし、値を入れる（.env.local は git に入らない）

# 【必須】Google AI Studio の APIキー（https://aistudio.google.com/apikey）。サーバー限定。
# この診断サイト専用のキーを新しく作る（AIコーチとは分ける。無料枠の回数を取り合わないように）
GEMINI_API_KEY=

# 【本番では必須】結果画面の申し込みボタンのリンク先（LINE公式アカウント・無料相談フォームなど）。
# 空なら「申し込み先は準備中です」と表示され、ボタンは出ない
# https:// で始まるURLだけ有効。それ以外（http:// や書き間違い）は空と同じ扱いになり、ボタンが出ない
NEXT_PUBLIC_CTA_URL=

# 【任意】申し込みボタンの文言。空なら「無料相談を申し込む」
NEXT_PUBLIC_CTA_LABEL=

# 【任意】本番のURL（例: https://shindan.example.com）。SNSでシェアしたときの画像・URLの基準になる
# 本番では必ず https:// から書く（「shindan.example.com」だけだと正しいURLとみなされず、使われない）
NEXT_PUBLIC_SITE_URL=
